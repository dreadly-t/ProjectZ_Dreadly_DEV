<config>
	
	<set xpath="/item_modifiers/item_modifier[@name='modArmorPlatingBasic']/@blocked_tags">noMods,rescuer,predator,maus</set>
	<set xpath="/item_modifiers/item_modifier[@name='modArmorPlatingReinforced']/@blocked_tags">noMods,rescuer,predator,maus</set>
	
	<append xpath="/item_modifiers">
		
		<!-- Enhanced equipment -->
		
		<item_modifier name="modEnhancedSpear" installable_tags="enhancedMelee" modifier_tags="enhanced" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="DescriptionKey" value="modEnhancedSpearDesc"/>
			<property name="Material" value="MUniversalParts"/>
			<property name="UnlockedBy" value="MasterArmor"/>
			<property name="EconomicValue" value="1500"/>
			<property name="CustomIcon" value="meleeWpnSpearT1IronSpear"/>
			<property name="CustomIconTint" value="FF6666"/>
			
			<effect_group tiered="false">
				<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$modEnhancedSpear" operation="set" value="1"/>
				<triggered_effect trigger="onSelfEquipStop" action="RemoveCVar" cvar="$modEnhancedSpear"/>
			</effect_group>
		</item_modifier>
		
		<item_modifier name="modEnhancedClub" installable_tags="enhancedMelee" modifier_tags="enhanced" blocked_tags="noMods" type="attachment">
