<config>
	
	<append xpath="/blocks/block[@name='bedroll']">
		<property name="BuffsWhenWalkedOn" value="buffSmallHomeStatus"/>
	</append>
	
	<append xpath="/blocks/block[@name='bed02']">
		<property name="BuffsWhenWalkedOn" value="buffBigHomeStatus"/>
		<property name="CanPickup" value="true" param1="bed02BlockVariantHelper"/>
		<property name="EconomicValue" value="60"/>	ц
		<property name="Stacknumber" value="15"/>
	</append>
	
	<append xpath="/blocks/block[@name='bunkBedMade']">
