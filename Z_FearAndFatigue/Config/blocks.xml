	</append>
	<append xpath="/blocks/block[@name='bunkBedMattress']">
		<property name="BuffsWhenWalkedOn" value="buffMediumHomeStatus"/>
		<property name="CanPickup" value="true" param1="recyclerBedMadeVariantHelper"/>
	</append>
	
	<append xpath="/blocks/block[@name='mattressFlatThin']">
		<property name="BuffsWhenWalkedOn" value="buffMediumHomeStatus"/>
		<property name="CanPickup" value="true"/>
		<property name="EconomicValue" value="15"/>
		<property name="Stacknumber" value="15"/>
	</append>
	
	<append xpath="/blocks/block[@name='mattressCurled']">
