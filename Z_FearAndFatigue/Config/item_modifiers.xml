<config>
	
	 <append xpath="/item_modifiers">
		
		<!-- For testing mechanics -->
		<item_modifier name="modArmorARResistHelmet" installable_tags="armorHead" modifier_tags="resistance" type="attachment">
		
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="UnlockedBy" value="craftingArmor"/>
			<property name="Material" value="MoreMetal"/>
			<property name="ItemTypeIcon" value="radiation"/>
			<property name="EconomicValue" value="1500"/>
			<property name="CustomIcon" value="modArmorPlatingReinforced"/>
			<property name="CustomIconTint" value="FF6666"/>
			
			<effect_group>
				<triggered_effect trigger="onSelfEquipStart" action="ModifyCVar" cvar="$armorHeadProtect" operation="set" value="1"/>
				<triggered_effect trigger="onSelfEquipStop" action="ModifyCVar" cvar="$armorHeadProtect" operation="set" value="0"/>
			</effect_group>
		</item_modifier>
		
		<item_modifier name="modFatigueTestingBoots" installable_tags="armorFeet" modifier_tags="resistance" type="attachment">
		
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="UnlockedBy" value="craftingArmor"/>
			<property name="Material" value="MoreMetal"/>
			<property name="ItemTypeIcon" value="radiation"/>
			<property name="EconomicValue" value="1500"/>
			<property name="CustomIcon" value="armorRaiderBoots"/>
			<property name="CustomIconTint" value="210,0,210"/>
			
			<effect_group tiered="false">			
				<triggered_effect trigger="onSelfItemActivate" action="AddBuff" buff="buffFatigueTesting"/>
				<triggered_effect trigger="onSelfItemDeactivate" action="RemoveBuff" buff="buffFatigueTesting"/>		
			</effect_group>
		
		</item_modifier>
		
	</append>
	
</config>