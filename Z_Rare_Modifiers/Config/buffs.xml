	<append xpath="/buffs/buff[@name='buffStatusCheck02']">
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$perkBookwormChance" operation="set" value="@$perkIntellectMasteryBonus"/>
