		</effect_group>
		<effect_group>		
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$LSSCount" operation="set" value="0"/>
			<!-- Calculation LSS count -->
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$LSSCount" operation="add" value="@$armorHeadLSS"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$LSSCount" operation="add" value="@$armorChestLSS"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$LSSCount" operation="add" value="@$armorHandsLSS"/>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$LSSCount" operation="add" value="@$armorFeetLSS"/>
			<!-- Add or Remove LSS Buff -->
			<triggered_effect trigger="onSelfBuffUpdate" action="AddBuff" buff="buffLSSset">
				<requirement name="CVarCompare" cvar="$LSSCount" operation="Equals" value="4"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffLSSset">
				<requirement name="CVarCompare" cvar="$LSSCount" operation="NotEquals" value="4"/>
			</triggered_effect>
			
			<triggered_effect trigger="onSelfEnteredGame" action="ModifyCVar" cvar="$StabilityStatus" operation="set" value="0"/>
		</effect_group>
		
		<effect_group name="Storm Resist Start">
			<requirement_group op="and">
				<requirement name="CVarCompare" cvar="$StormResistHelmet" operation="EQ" value="1"/>
				<requirement name="CVarCompare" cvar="$StormResistOutfit" operation="EQ" value="1"/>
				<requirement name="CVarCompare" cvar="$StormResistGloves" operation="EQ" value="1"/>
				<requirement name="CVarCompare" cvar="$StormResistBoots" operation="EQ" value="1"/>
			</requirement_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$StormResist" operation="set" value="1"/>
		</effect_group>
		<effect_group name="Storm Resist Start">
			<requirement_group op="or">
				<requirement name="CVarCompare" cvar="$StormResistHelmet" operation="LT" value="1"/>
				<requirement name="CVarCompare" cvar="$StormResistOutfit" operation="LT" value="1"/>
				<requirement name="CVarCompare" cvar="$StormResistGloves" operation="LT" value="1"/>
				<requirement name="CVarCompare" cvar="$StormResistBoots" operation="LT" value="1"/>
			</requirement_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$StormResist" operation="set" value="0"/>
		</effect_group>
		
	</append>
	
