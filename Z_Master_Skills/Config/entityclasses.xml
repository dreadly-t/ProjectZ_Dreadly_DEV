				<triggered_effect trigger="onSelfKilledOther" action="ModifyCVar" cvar="$IndianaMasterBonus" operation="add" value="1">
					<requirement name="CVarCompare" cvar="$IndianaMasterCounter" operation="GTE" value="5"/>
					<requirement name="CVarCompare" cvar="$IndianaMasterBonus" operation="LT" value="100"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfKilledOther" action="RemoveCVar" cvar="$IndianaMasterCounter">
					<requirement name="CVarCompare" cvar="$IndianaMasterCounter" operation="GTE" value="5"/></triggered_effect>
					
