<configs>
	
	<insertAfter xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/passive_effect[@name='HarvestCount' and contains(@tags, 'allToolsHarvest')]">
		<passive_effect name="HarvestCount" operation="base_set" value="0" tags="butcherHarvestMutation"/>
	</insertAfter>
		
	<append xpath="/entity_classes/entity_class[@name='playerMale']">
		
		<effect_group name="Avenger">
			<requirement name="HoldingItemHasTags" tags="Avenger"/>
				<triggered_effect trigger="onOtherDamagedSelf" action="AddBuff" buff="BuffBulldogAvenger"/>
		</effect_group>
		<effect_group name="Combistick">	
			<requirement name="HasBuff" target="other" buff="buffEnemyPredatorBonus"/>
			<requirement name="CVarCompare" cvar="$CombistickPredatorBonus" operation="EQ" value="1"/>
				<passive_effect name="EntityDamage" operation="perc_add" value="2"/>
		</effect_group>
		
		<!-- Developing Masterful Weapon Handling -->
		
