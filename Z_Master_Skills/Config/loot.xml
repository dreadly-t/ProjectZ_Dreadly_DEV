	<!-- Adding Legendary Parts to Treasures -->
	<insertAfter xpath="/lootcontainers/lootgroup[@name='groupBuriedTreasure']/item[@group='groupAmmoPileLarge']">
		<item group="groupTreasure_LegendPart" prob=".2" force_prob="true"/>
	</insertAfter>
	
	<insertAfter xpath="/lootcontainers/lootcontainer[@name='roboticDrone']">
		<lootcontainer name="roboticDrone1" count="0" size="2,2" sound_open="UseActions/vehicle_storage_open" open_time="0" sound_close="UseActions/vehicle_storage_close" loot_quality_template="qualBaseTemplate"></lootcontainer>
