<config>
		
	<!-- Chance to find precious metals in loot	-->
	<insertAfter xpath="/lootcontainers/lootgroup[@name='groupScrapRare']">
		<lootgroup name="groupPerkPlundererChance">
			<item name="resourceSilverNugget" count="4,6" prob=".5"/>
			<item name="resourceGoldNugget" count="2,4" prob=".4"/>
			<item name="resourceRawDiamond" count="1,2" prob=".3"/>
			<item name="resourcePreciousMetals" prob=".05"/>
			<item name="UniqueParts" prob=".025"/>
		</lootgroup>
		<lootgroup name="groupPerkPlundererChanceHightLoot">
			<item name="resourceSilverNugget" count="4,6" prob=".5" loot_stage_count_mod="0.001"/>
			<item name="resourceGoldNugget" count="2,4" prob=".4" loot_stage_count_mod="0.001"/>
			<item name="resourceRawDiamond" count="1,2" prob=".3" loot_stage_count_mod="0.001"/>
			<item name="resourcePreciousMetals" count="1,2" prob=".1"/>
			<item name="UniqueParts" prob=".02"/>
		</lootgroup>
	</insertAfter>
	
	
	<append xpath="/lootcontainers/lootgroup[@name='groupZpackReg']">
		<item group="groupPerkPlundererChance" count="1" buffs="buffPerkPlundererSuccess">
			<requirement class="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="@$plundererSuccess"/>
		</item>
	</append>
