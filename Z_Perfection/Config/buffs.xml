<config>
	
	<append xpath="/buffs/buff[@name='buffStatusCheck02']">
		<effect_group>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$critHitNaturalHealingRate" operation="add" value="@$SelfMedicationCritNaturalHealing"/>
			
			<!-- Increased recovery speed for critical damage while in a medical bed -->
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$critHitNaturalHealingRate" operation="add" value=".5">
				<requirement name="CVarCompare" cvar="$HospitalBedStatus" operation="GTE" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$critHitNaturalHealingRate" operation="add" value="1">
				<requirement name="CVarCompare" cvar="$HospitalBedTreatmentStatus" operation="GTE" value="1"/></triggered_effect>
			<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar="$critHitNaturalHealingRate" operation="add" value="3">
				<requirement name="CVarCompare" cvar="$HospitalBedResuscitationStatus" operation="GTE" value="1"/></triggered_effect>
		</effect_group>
	</append>
	
	<append xpath="/buffs">
	   <buff name="buffXPBonus" name_key="buffXPBonusName" tooltip_key="buffXPBonusTooltip" description_key="buffXPBonusIncDesc" icon="ui_game_symbol_skills" icon_color="61,162,255">
            <stack_type value="replace"/>
			<duration value="10"/>
			<effect_group>				
                <passive_effect name="PlayerExpGain" operation="perc_add" value=".05"/>
            </effect_group>
       </buff>
	   
	   <buff name="buffBonusMissChance" name_key="buffBonusMissChanceName" description_key="buffBonusMissChanceIncDesc" icon="ui_game_symbol_stealth2" icon_color="180,180,180">
            <stack_type value="replace"/>
			<duration value="3"/>
			
			<effect_group>				
                <triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$BonusMissChance" operation="set" value="10"/>
				<triggered_effect trigger="onSelfBuffRemove" action="RemoveCVar" cvar="$BonusMissChance"/>
            </effect_group>
       </buff>
    </append>
	
</config>