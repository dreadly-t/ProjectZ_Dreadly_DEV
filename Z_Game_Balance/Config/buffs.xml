<config>
	
	<append xpath="/buffs/buff[@name='buffStatusCheck02']">
				
		<effect_group>
			<triggered_effect trigger="onSelfEnteredGame" action="RemoveBuff" buff="buffWasteland_Storm,buffSnow_Storm,buffDesert_Storm,buffBurnt_Storm"/>
		
			<passive_effect name="PlayerExpGain" operation="perc_add" value="-1" tags="Looting"/>
			
			<triggered_effect trigger="onCombatEntered" action="AddBuff" buff="buffBlockIsInCombat"/>
			<triggered_effect trigger="onCombatEntered" action="RemoveBuff" buff="buffSmallHome,buffMediumHome,buffBigHome,buffTrainingCardio,buffTrainingLoads,buffHospitalBedTreatment,buffNerdDesk,buffNerdTable"/>
		</effect_group>
		
	</append>
	<append xpath="/buffs">
		<buff name="buffBlockIsInCombat" hidden="true">
			<stack_type value="replace"/>
			<duration value="3"/>
		</buff>
	</append>
	
	<!-- The repulsor effect is switchable. -->	
	
	<remove xpath="/buffs/buff[@name='buffmodMeleeStunBatonRepulsor']"/>
	<append xpath="/buffs">
		<buff name="buffmodMeleeStunBatonRepulsor" name_key="buffmodMeleeStunBatonRepulsorName" tooltip_key="buffmodMeleeStunBatonRepulsorTooltip" description_key="buffmodMeleeStunBatonRepulsorIncDesc" icon="ui_game_symbol_electric_plugin" icon_color="215,140,55">
			<stack_type value="ignore"/>
			<duration value="0"/>
			<display_value_key value="StunBatonRepulsor"/>
			<display_value value="xxx"/>
			
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="PlaySound" sound="switch_up" play_in_head="true"/>
				<triggered_effect trigger="onSelfBuffRemove" action="PlaySound" sound="switch_down" play_in_head="true"/>
			</effect_group>

		</buff>
	</append>
	
</config>