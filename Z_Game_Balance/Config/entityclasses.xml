<configs>
	
	<insertAfter xpath="/entity_classes/entity_class[@name='playerMale']/effect_group/passive_effect[@name='HarvestCount' and contains(@tags, 'allToolsHarvest')]">
		<passive_effect name="HarvestCount" operation="base_set" value="0" tags="modPreciousMetals"/>
		<passive_effect name="HarvestCount" operation="base_set" value="0" tags="modPreciousMetalsUnique"/>
		
		<passive_effect name="DamageModifier" operation="perc_add" value="-.75" tags="lockedSafe"/>
	</insertAfter>
	
	<append xpath="/entity_classes/entity_class[@name='playerMale']">
		
		<effect_group name="Kill Counters">
			<requirement name="HitLocation" body_parts="Head"/>
			<requirement name="HoldingItemHasTags" tags="perkArchery"/>
				<passive_effect name="PlayerExpGain" operation="perc_add" value=".25" tags="Kill"/>
		</effect_group>
	</append>
	
	<set xpath="/entity_classes/entity_class[@name='zombieTemplateMale']/property[@name='LootDropProb']/@value">.025</set>
	
</configs>