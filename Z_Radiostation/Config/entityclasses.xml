<configs>
	
	<insertAfter xpath="/entity_classes/entity_class[contains(@name, 'Radiated')]/property[@name='ExperienceGain']">
		<drop event="Harvest" name="resourceMutationSamples" tag="butcherHarvestMutation" count="1"/>
	</insertAfter>
	
	<insertAfter xpath="/entity_classes/entity_class[contains(@name, 'Charged') and not(contains(@name, 'Elite'))]/property[@name='ExperienceGain']">
		<drop event="Harvest" name="resourceMutationSamples" tag="butcherHarvestMutation" count="2"/>
	</insertAfter>
	
	<insertAfter xpath="/entity_classes/entity_class[contains(@name, 'Infernal') and not(contains(@name, 'Elite'))]/property[@name='ExperienceGain']">
